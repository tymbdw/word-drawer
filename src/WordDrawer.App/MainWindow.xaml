<Window x:Class="WordDrawer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="词隙" Width="448" Height="608"
        MinWidth="448" MaxWidth="448" MinHeight="608" MaxHeight="608"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="True" Topmost="False"
        Icon="Assets/worddrawer.ico"
        FontFamily="Aptos, Microsoft YaHei UI"
        KeyDown="Window_KeyDown" MouseEnter="Window_MouseEnter" MouseLeave="Window_MouseLeave"
        MouseMove="Window_MouseMove">
    <Window.Resources>
        <SolidColorBrush x:Key="TextPrimary" Color="#FF182633" />
        <SolidColorBrush x:Key="TextSecondary" Color="#FF5B7185" />
        <SolidColorBrush x:Key="Accent" Color="#FF2899D6" />

        <!-- Theme-swappable surfaces. ApplyTheme() replaces these at runtime. -->
        <SolidColorBrush x:Key="StrokeStrong" Color="#8FFFFFFF" />
        <SolidColorBrush x:Key="StrokeSoft" Color="#26425D70" />
        <SolidColorBrush x:Key="Divider" Color="#1A425D70" />
        <SolidColorBrush x:Key="ButtonFill" Color="#16FFFFFF" />
        <SolidColorBrush x:Key="PanelFill" Color="#22FFFFFF" />
        <SolidColorBrush x:Key="PanelStroke" Color="#33FFFFFF" />
        <SolidColorBrush x:Key="TrackFill" Color="#20425D70" />
        <SolidColorBrush x:Key="PrimaryFill" Color="#FF182633" />
        <SolidColorBrush x:Key="PrimaryText" Color="#FFF6FAFC" />
        <LinearGradientBrush x:Key="CardSurface" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#7CF6FCFF" Offset="0" />
            <GradientStop Color="#2AFFFFFF" Offset="1" />
        </LinearGradientBrush>

        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Background" Value="{DynamicResource ButtonFill}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StrokeSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="15"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.86" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.65" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
            <Setter Property="Background" Value="{DynamicResource PrimaryFill}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="9" />
        </Style>

        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="86" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="7,12,7,10" />
        </Style>

        <Style x:Key="SegmentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="11,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource StrokeSoft}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="StepperButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Background" Value="#14FFFFFF" />
            <Setter Property="BorderBrush" Value="{DynamicResource StrokeSoft}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="SettingTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>

        <Style x:Key="SettingHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        </Style>

        <Style x:Key="HomeProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="4" />
            <Setter Property="Background" Value="{DynamicResource TrackFill}" />
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border CornerRadius="2" Background="{TemplateBinding Background}" />
                            <Border x:Name="PART_Track" CornerRadius="2">
                                <Decorator x:Name="PART_Indicator" HorizontalAlignment="Left">
                                    <Border CornerRadius="2" Background="{TemplateBinding Foreground}" />
                                </Decorator>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- outer drop shadow; the glass panel below is opaque, so only the halo shows -->
        <Border x:Name="WindowShadowFar" CornerRadius="28" Background="#FF0B233A" Opacity="0.55"
                Margin="44,44,44,50" IsHitTestVisible="False" Visibility="Collapsed">
            <Border.Effect>
                <BlurEffect Radius="44" />
            </Border.Effect>
            <Border.RenderTransform>
                <TranslateTransform Y="14" />
            </Border.RenderTransform>
        </Border>
        <Border x:Name="WindowShadowNear" CornerRadius="28" Background="#FF123E5E" Opacity="0.22"
                Margin="48,48,48,54" IsHitTestVisible="False" Visibility="Collapsed">
            <Border.Effect>
                <BlurEffect Radius="7" />
            </Border.Effect>
            <Border.RenderTransform>
                <TranslateTransform Y="3" />
            </Border.RenderTransform>
        </Border>

        <Border x:Name="GlassSurface" Margin="44" CornerRadius="28" BorderThickness="1" BorderBrush="{DynamicResource StrokeStrong}"
                Background="#62E7F5FD">
        <Grid ClipToBounds="True">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="58" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="{DynamicResource StrokeSoft}" BorderThickness="0,0,0,1"
                        Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown"
                        MouseMove="Header_MouseMove" MouseLeftButtonUp="Header_MouseLeftButtonUp">
                    <Grid Margin="18,0,15,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Width="26" Height="26" Source="Assets/logo-256.png"
                                   Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="词隙" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}" />
                                <TextBlock Text="Window Word" Margin="0,3,0,0" FontFamily="Aptos"
                                           FontSize="9"
                                           Foreground="{DynamicResource TextSecondary}" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="PinButton" Style="{StaticResource IconButton}"
                                    ToolTip="固定窗口" Click="PinButton_Click">
                                <Path x:Name="PinGlyph" Width="18" Height="18" Stretch="Uniform"
                                      Stroke="{DynamicResource TextPrimary}" StrokeThickness="1.6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M14,4 L20,10 L17,11 L13,15 L12,20 L10,14 L4,8 L9,7 L13,3 L14,4 M4,20 L10,14" />
                            </Button>
                            <Button Style="{StaticResource IconButton}" ToolTip="设置" Click="SettingsButton_Click">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="17"
                                           FontWeight="Normal" Foreground="{DynamicResource TextPrimary}" />
                            </Button>
                            <Button Style="{StaticResource IconButton}" ToolTip="退出程序" Click="ExitButton_Click">
                                <TextBlock Text="&#x2715;" FontSize="13" FontWeight="Normal"
                                           Foreground="{DynamicResource TextPrimary}" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid x:Name="HomeView" Grid.Row="1" Margin="18,16,18,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="69" />
                        <RowDefinition Height="140" />
                        <RowDefinition Height="57" />
                        <RowDefinition Height="115" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <StackPanel>
                            <TextBlock x:Name="TodayDateText" Text="10 月 17 日 · 星期六"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondary}" />
                            <TextBlock Text="今晚，继续背词。" Margin="0,7,0,0"
                                       FontFamily="Baskerville, Georgia" FontSize="26"
                                       FontWeight="Normal" Foreground="{DynamicResource TextPrimary}" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1">
                    <Border CornerRadius="22" BorderThickness="1" BorderBrush="#FF182633"
                            Opacity="0.22" Margin="1,8,1,1" IsHitTestVisible="False">
                        <Border.Effect>
                            <BlurEffect Radius="13" />
                        </Border.Effect>
                    </Border>
                    <Border CornerRadius="22" BorderBrush="{DynamicResource StrokeStrong}"
                            BorderThickness="1" Background="{DynamicResource CardSurface}" Padding="18">
                        <Grid ClipToBounds="True">
                            <Ellipse Width="120" Height="120" HorizontalAlignment="Right" VerticalAlignment="Top"
                                     Margin="0,-79,-66,0" Stroke="#702899D6" StrokeThickness="1"
                                     Fill="Transparent" IsHitTestVisible="False" />
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <TextBlock Text="今日任务" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock x:Name="TodayTargetText" Text="0 / 50" HorizontalAlignment="Right"
                                               FontSize="10" Foreground="{DynamicResource TextSecondary}" />
                                </Grid>
                                <Grid Grid.Row="1" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="78" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Margin="0,0,6,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="1" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="NewCountText" Text="—" FontFamily="Baskerville, Georgia"
                                                       FontSize="34" FontWeight="Normal" LineHeight="32"
                                                       Foreground="{DynamicResource TextPrimary}" />
                                            <TextBlock Text="仍需学习" Margin="0,6,0,0" FontSize="11"
                                                       Foreground="{DynamicResource TextSecondary}" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Height="40" VerticalAlignment="Center"
                                                Background="#24425D70" />
                                        <StackPanel Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="ReviewCountText" Text="—" FontFamily="Baskerville, Georgia"
                                                       FontSize="34" FontWeight="Normal" LineHeight="32"
                                                       Foreground="{DynamicResource TextPrimary}" />
                                            <TextBlock Text="等待复习" Margin="0,6,0,0" FontSize="11"
                                                       Foreground="{DynamicResource TextSecondary}" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid Grid.Column="1" Width="72" Height="72" VerticalAlignment="Center"
                                          HorizontalAlignment="Right">
                                        <Ellipse Stroke="#2E425D70" StrokeThickness="6" />
                                        <Ellipse x:Name="ProgressArc" Stroke="{DynamicResource Accent}" StrokeThickness="6"
                                                 StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                 RenderTransformOrigin="0.5,0.5">
                                            <Ellipse.RenderTransform>
                                                <RotateTransform Angle="-90" />
                                            </Ellipse.RenderTransform>
                                        </Ellipse>
                                        <TextBlock x:Name="ProgressRingText" Text="0" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" FontFamily="Baskerville, Georgia"
                                                   FontSize="20" Foreground="{DynamicResource TextPrimary}" />
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.35*" />
                            <ColumnDefinition Width="9" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <Border CornerRadius="15" Background="#FF182633" Opacity="0.16"
                                    Margin="8,11,8,-5" IsHitTestVisible="False">
                                <Border.Effect>
                                    <BlurEffect Radius="12" />
                                </Border.Effect>
                            </Border>
                        <Button x:Name="StartStudyButton" Height="47"
                                Style="{StaticResource PrimaryButton}" IsEnabled="False"
                                Click="StartStudy_Click">
                            <StackPanel>
                                <TextBlock Text="开始学习" HorizontalAlignment="Center" FontSize="13"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="LearnedTodayText" Text="今天已完成 0 个" Margin="0,3,0,0"
                                           HorizontalAlignment="Center" FontFamily="Aptos"
                                           FontSize="8.5" FontWeight="Normal" Opacity="0.62" />
                            </StackPanel>
                        </Button>
                        </Grid>
                        <Button x:Name="StartReviewButton" Grid.Column="2" Height="47"
                                Click="StartReview_Click">
                            <StackPanel>
                                <TextBlock Text="去复习" HorizontalAlignment="Center" FontSize="13"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Grid Grid.Row="3" Margin="0,15,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource NavButton}" Tag="词书" Click="NavigationPlaceholder_Click">
                            <StackPanel>
                                <Path Width="22" Height="22" Stretch="Uniform" Stroke="{DynamicResource Accent}"
                                      StrokeThickness="1.45" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M4,5.5 C4,4.12 5.12,3 6.5,3 H20 V19 H6.5 C5.12,19 4,20.12 4,21.5 Z M4,5.5 V21.5 M8,7 H16 M8,11 H14" />
                                <TextBlock Text="词书" Margin="0,9,0,0" HorizontalAlignment="Center" FontSize="11" />
                                <TextBlock x:Name="BookCountText" Text="当前 1 本" Margin="0,4,0,0" HorizontalAlignment="Center"
                                           FontSize="9" FontWeight="Normal" Foreground="{DynamicResource TextSecondary}" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Style="{StaticResource NavButton}" Tag="学习计划" Click="NavigationPlaceholder_Click">
                            <StackPanel>
                                <Path Width="22" Height="22" Stretch="Uniform" Stroke="{DynamicResource Accent}"
                                      StrokeThickness="1.45" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M6,3 V6 M18,3 V6 M4,8 H20 M5,5 H19 C19.55,5 20,5.45 20,6 V20 H4 V6 C4,5.45 4.45,5 5,5 Z M8,13 L10,15 L15,10" />
                                <TextBlock Text="学习计划" Margin="0,9,0,0" HorizontalAlignment="Center" FontSize="11" />
                                <TextBlock x:Name="PlanPerDayText" Text="每日 0 词" Margin="0,4,0,0" HorizontalAlignment="Center"
                                           FontSize="9" FontWeight="Normal" Foreground="{DynamicResource TextSecondary}" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="4" Style="{StaticResource NavButton}" Tag="学习成果" Click="NavigationPlaceholder_Click">
                            <StackPanel>
                                <Path Width="22" Height="22" Stretch="Uniform" Stroke="{DynamicResource Accent}"
                                      StrokeThickness="1.45" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M4,20 V10 M10,20 V4 M16,20 V13 M22,20 V7" />
                                <TextBlock Text="学习成果" Margin="0,9,0,0" HorizontalAlignment="Center" FontSize="11" />
                                <TextBlock x:Name="TotalStudiedText" Text="已学 0" Margin="0,4,0,0"
                                           HorizontalAlignment="Center" FontSize="9" FontWeight="Normal"
                                           Foreground="{DynamicResource TextSecondary}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>

                <Grid x:Name="StudyView" Grid.Row="1" Margin="14,12,14,25"
                      Visibility="Collapsed" Focusable="True" FocusVisualStyle="{x:Null}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="60" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Button Content="←" Width="38" Height="32" HorizontalAlignment="Left"
                                Background="Transparent" BorderThickness="0" Click="BackHome_Click" />
                        <Button x:Name="SpeakButton" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Height="26" Width="30" Margin="0,0,6,0" Style="{StaticResource SegmentButton}"
                                ToolTip="朗读单词" Click="SpeakButton_Click">
                            <Path Width="14" Height="14" Stretch="Uniform"
                                  Data="M3,8 L6,8 L10,4 L10,18 L6,14 L3,14 Z M13,7 C15,9 15,13 13,15"
                                  Stroke="{DynamicResource TextPrimary}" StrokeThickness="1.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" />
                        </Button>
                        <Button x:Name="MeaningToggleButton" Content="释义" HorizontalAlignment="Right" Margin="0,0,42,0"
                                VerticalAlignment="Center" Height="26" Padding="10,0" FontSize="10"
                                Style="{StaticResource SegmentButton}" Click="ToggleMeaning_Click" />
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock x:Name="SessionTitleText" Text="今日新词" HorizontalAlignment="Center"
                                       FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock x:Name="SessionProgressText" Text="1 / 5" HorizontalAlignment="Center"
                                       Margin="0,3,0,0" FontSize="9.5" Foreground="{DynamicResource TextSecondary}" />
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="58" />
                        </Grid.RowDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,0,10">
                            <TextBlock x:Name="EnglishWordText" Text="meticulous" TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis" TextAlignment="Center"
                                       FontFamily="Baskerville, Georgia" FontSize="42"
                                       Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock x:Name="MeaningText" Text="adj. 一丝不苟的；极注意细节的"
                                       TextWrapping="Wrap" TextAlignment="Center" Margin="18,16,18,0"
                                       FontSize="14" LineHeight="24" Foreground="{DynamicResource TextPrimary}" />
                        </StackPanel>
                        <Grid Grid.Row="1">
                            <Button Content="←" Width="44" Height="36" HorizontalAlignment="Left"
                                    Background="Transparent" BorderThickness="0"
                                    ToolTip="仅切换，不记录" Click="PreviousWord_Click" />
                            <TextBlock Text="← 仅切换 · → 认识" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontSize="9" Foreground="{DynamicResource TextSecondary}" />
                            <Button Content="→" Width="44" Height="36" HorizontalAlignment="Right"
                                    Background="Transparent" BorderThickness="0"
                                    ToolTip="标记为认识" Click="Known_Click" />
                        </Grid>
                    </Grid>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="9" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Height="48" Content="不认识" Click="Unknown_Click" />
                        <Button Grid.Column="2" Height="48" Content="认识"
                                Background="#5A91DDFB" BorderBrush="#702899D6" Click="Known_Click" />
                    </Grid>
                </Grid>

                <Grid x:Name="SettingsView" Grid.Row="1" Margin="14,12,14,25" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Button Content="←" Width="38" Height="32" HorizontalAlignment="Left"
                                Background="Transparent" BorderThickness="0" Click="BackToHome_Click" />
                        <TextBlock Text="设置" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                        <TextBlock x:Name="VersionText" Text="v0.0.0" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" FontSize="8.5"
                                   Foreground="{DynamicResource TextSecondary}" />
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>

                        <Border CornerRadius="16" Background="{DynamicResource PanelFill}"
                                BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1"
                                Padding="14,11" Margin="0,0,0,8">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="材质" Style="{StaticResource SettingTitle}" />
                                    <TextBlock Text="雾银 / 冰蓝 / 夜蓝" Style="{StaticResource SettingHint}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button x:Name="ThemeMistButton" Content="雾银" Style="{StaticResource SegmentButton}" Click="ThemeMist_Click" />
                                    <Button x:Name="ThemeIceButton" Content="冰蓝" Style="{StaticResource SegmentButton}" Margin="6,0,0,0" Click="ThemeIce_Click" />
                                    <Button x:Name="ThemeNightButton" Content="夜蓝" Style="{StaticResource SegmentButton}" Margin="6,0,0,0" Click="ThemeNight_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border CornerRadius="16" Background="{DynamicResource PanelFill}"
                                BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1"
                                Padding="14,11" Margin="0,0,0,8">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="透明度" Style="{StaticResource SettingTitle}" />
                                    <TextBlock Text="越低越透，磨砂仍然生效" Style="{StaticResource SettingHint}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Content="−" Style="{StaticResource StepperButton}" Click="GlassAlphaDown_Click" />
                                    <TextBlock x:Name="GlassAlphaText" Text="31%" Width="46" TextAlignment="Center"
                                               VerticalAlignment="Center" FontFamily="Baskerville, Georgia"
                                               FontSize="17" Foreground="{DynamicResource TextPrimary}" />
                                    <Button Content="+" Style="{StaticResource StepperButton}" Click="GlassAlphaUp_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border CornerRadius="16" Background="{DynamicResource PanelFill}"
                                BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1"
                                Padding="14,11" Margin="0,0,0,8">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="贴边位置" Style="{StaticResource SettingTitle}" />
                                    <TextBlock Text="拖到屏幕边缘也可以" Style="{StaticResource SettingHint}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button x:Name="DockLeftButton" Content="左" Style="{StaticResource SegmentButton}" Click="DockLeft_Click" />
                                    <Button x:Name="DockRightButton" Content="右" Style="{StaticResource SegmentButton}" Margin="6,0,0,0" Click="DockRight_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border CornerRadius="16" Background="{DynamicResource PanelFill}"
                                BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1"
                                Padding="14,11" Margin="0,0,0,8">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="鼠标离开后收起" Style="{StaticResource SettingTitle}" />
                                    <TextBlock Text="延迟 0.65 秒" Style="{StaticResource SettingHint}" />
                                </StackPanel>
                                <Button x:Name="AutoHideButton" Content="开" Width="44" Height="26"
                                            HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Style="{StaticResource SegmentButton}" Click="ToggleAutoHide_Click" />
                            </Grid>
                        </Border>
                        <Border CornerRadius="16" Background="{DynamicResource PanelFill}"
                                BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1"
                                Padding="14,11" Margin="0,0,0,8">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="每日新增上限" Style="{StaticResource SettingTitle}" />
                                    <TextBlock Text="10–200，步长 10" Style="{StaticResource SettingHint}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Content="−" Style="{StaticResource StepperButton}" Click="DailyTargetDown_Click" />
                                    <TextBlock x:Name="DailyTargetText" Text="50" Width="46" TextAlignment="Center"
                                               VerticalAlignment="Center" FontFamily="Baskerville, Georgia"
                                               FontSize="17" Foreground="{DynamicResource TextPrimary}" />
                                    <Button Content="+" Style="{StaticResource StepperButton}" Click="DailyTargetUp_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border CornerRadius="16" Background="{DynamicResource PanelFill}"
                                BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1"
                                Padding="14,11" Margin="0,0,0,8">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="每日复习上限" Style="{StaticResource SettingTitle}" />
                                    <TextBlock Text="50–500，步长 50" Style="{StaticResource SettingHint}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Content="−" Style="{StaticResource StepperButton}" Click="ReleaseLimitDown_Click" />
                                    <TextBlock x:Name="ReleaseLimitText" Text="200" Width="46" TextAlignment="Center"
                                               VerticalAlignment="Center" FontFamily="Baskerville, Georgia"
                                               FontSize="17" Foreground="{DynamicResource TextPrimary}" />
                                    <Button Content="+" Style="{StaticResource StepperButton}" Click="ReleaseLimitUp_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border CornerRadius="16" Background="{DynamicResource PanelFill}"
                                BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1"
                                Padding="14,11" Margin="0,0,0,8">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="开机自启" Style="{StaticResource SettingTitle}" />
                                    <TextBlock Text="登录后自动运行" Style="{StaticResource SettingHint}" />
                                </StackPanel>
                                <Button x:Name="StartupButton" Content="关" Width="44" Height="26"
                                            HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Style="{StaticResource SegmentButton}" Click="ToggleStartup_Click" />
                            </Grid>
                        </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="PlanView" Grid.Row="1" Margin="14,12,14,25" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Button Content="←" Width="38" Height="32" HorizontalAlignment="Left"
                                Background="Transparent" BorderThickness="0" Click="BackToHome_Click" />
                        <TextBlock Text="学习计划" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                    </Grid>

                    <StackPanel Grid.Row="1">
                        <Border CornerRadius="18" Background="{DynamicResource PanelFill}"
                                BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1" Padding="16,14">
                            <StackPanel>
                                <TextBlock x:Name="PlanBookText" Text="词书：—" FontSize="11"
                                           Foreground="{DynamicResource TextSecondary}" />

                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="1" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock x:Name="PlanRemainingText" Text="—" FontFamily="Baskerville, Georgia"
                                                   FontSize="26" Foreground="{DynamicResource TextPrimary}" />
                                        <TextBlock Text="剩余未学" Margin="0,5,0,0" FontSize="10"
                                                   Foreground="{DynamicResource TextSecondary}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="14,0,0,0">
                                        <TextBlock x:Name="PlanDaysText" Text="—" FontFamily="Baskerville, Georgia"
                                                   FontSize="26" Foreground="{DynamicResource TextPrimary}" />
                                        <TextBlock Text="按当前速度" Margin="0,5,0,0" FontSize="10"
                                                   Foreground="{DynamicResource TextSecondary}" />
                                    </StackPanel>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource Divider}" Margin="0,16,0,12" />
                                <TextBlock Text="每日新增与复习上限可在设置页调整。改完之后首页的目标环和待学数量会立刻跟着变。"
                                           FontSize="9.5" TextWrapping="Wrap" LineHeight="17"
                                           Foreground="{DynamicResource TextSecondary}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <Grid x:Name="WordBookView" Grid.Row="1" Margin="14,12,14,25" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Button Content="←" Width="38" Height="32" HorizontalAlignment="Left"
                                Background="Transparent" BorderThickness="0" Click="BackToHome_Click" />
                        <TextBlock Text="词书" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="BookListPanel" Margin="0,2,0,8" />
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="ResultsView" Grid.Row="1" Margin="14,12,14,25" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Button Content="←" Width="38" Height="32" HorizontalAlignment="Left"
                                Background="Transparent" BorderThickness="0" Click="BackToHome_Click" />
                        <TextBlock Text="学习成果" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Border CornerRadius="18" Background="{DynamicResource PanelFill}"
                                BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1" Padding="16,14">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="1" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock x:Name="ResultActiveDaysText" Text="—" FontFamily="Baskerville, Georgia"
                                                   FontSize="30" Foreground="{DynamicResource TextPrimary}" />
                                        <TextBlock Text="学习天数" Margin="0,4,0,0" FontSize="10"
                                                   Foreground="{DynamicResource TextSecondary}" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Height="38" VerticalAlignment="Center"
                                            Background="{DynamicResource Divider}" />
                                    <StackPanel Grid.Column="2" Margin="14,0,0,0">
                                        <TextBlock x:Name="ResultStreakText" Text="—" FontFamily="Baskerville, Georgia"
                                                   FontSize="30" Foreground="{DynamicResource TextPrimary}" />
                                        <TextBlock Text="连续天数" Margin="0,4,0,0" FontSize="10"
                                                   Foreground="{DynamicResource TextSecondary}" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock x:Name="ResultSummaryText" Text="—" Margin="0,10,0,0" FontSize="9"
                                           TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" />

                                <Border Height="1" Background="{DynamicResource Divider}" Margin="0,14,0,12" />

                                <Grid>
                                    <TextBlock Text="最近 90 天" FontSize="10"
                                               Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock x:Name="HeatDetailText" Text="" HorizontalAlignment="Right"
                                               FontSize="10" Foreground="{DynamicResource TextSecondary}" />
                                </Grid>

                                <Grid x:Name="HeatMonthRow" Height="14" Margin="28,8,0,0" />

                                <Grid Margin="0,1,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0" Height="112">
                                        <Grid.RowDefinitions>
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="周一" FontSize="8" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondary}" />
                                        <TextBlock Grid.Row="2" Text="周三" FontSize="8" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondary}" />
                                        <TextBlock Grid.Row="4" Text="周五" FontSize="8" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondary}" />
                                    </Grid>
                                    <Grid x:Name="HeatmapGrid" Grid.Column="1" Height="112" Margin="0,0,0,0" />
                                </Grid>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                    <TextBlock Text="少" FontSize="8.5" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondary}" />
                                    <Border x:Name="Legend0" Width="10" Height="10" CornerRadius="2" Margin="6,0,0,0"
                                            Background="{DynamicResource Divider}" />
                                    <Border x:Name="Legend1" Width="10" Height="10" CornerRadius="2" Margin="3,0,0,0"
                                            Background="#4D2899D6" />
                                    <Border x:Name="Legend2" Width="10" Height="10" CornerRadius="2" Margin="3,0,0,0"
                                            Background="#992899D6" />
                                    <Border x:Name="Legend3" Width="10" Height="10" CornerRadius="2" Margin="3,0,0,0"
                                            Background="#FF2899D6" />
                                    <TextBlock Text="多" FontSize="8.5" VerticalAlignment="Center" Margin="6,0,0,0"
                                               Foreground="{DynamicResource TextSecondary}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                </Grid>

                <TextBlock x:Name="StatusText" Grid.Row="1" Margin="20,0,20,7"
                           VerticalAlignment="Bottom" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                           FontSize="8.5" Foreground="{DynamicResource TextSecondary}"
                           Text="本地保存 · 右侧贴边" />
            </Grid>
        </Grid>
        </Border>
    </Grid>
</Window>
