                <Grid x:Name="WordBookView" Grid.Row="1" Margin="14,12,14,25" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Button Content="←" Width="38" Height="32" HorizontalAlignment="Left"
                                Background="Transparent" BorderThickness="0" Click="BackToHome_Click" />
                        <TextBlock Text="词书" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                    </Grid>

                    <StackPanel Grid.Row="1">
                        <Border CornerRadius="18" Background="{DynamicResource PanelFill}"
                                BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1" Padding="16,14">
                            <StackPanel>
                                <TextBlock x:Name="BookNameText" Text="—" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" />
                                <TextBlock x:Name="BookSourceText" Text="—" Margin="0,6,0,0" FontSize="9"
                                           Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />

                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="1" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock x:Name="BookTotalText" Text="—" FontFamily="Baskerville, Georgia"
                                                   FontSize="24" Foreground="{DynamicResource TextPrimary}" />
                                        <TextBlock Text="总词数" Margin="0,5,0,0" FontSize="10"
                                                   Foreground="{DynamicResource TextSecondary}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock x:Name="BookLearnedText" Text="—" FontFamily="Baskerville, Georgia"
                                                   FontSize="24" Foreground="{DynamicResource TextPrimary}" />
                                        <TextBlock Text="已学" Margin="0,5,0,0" FontSize="10"
                                                   Foreground="{DynamicResource TextSecondary}" />
                                    </StackPanel>
                                </Grid>

                                <ProgressBar x:Name="BookProgressBar" Style="{StaticResource HomeProgress}"
                                             Minimum="0" Maximum="100" Value="0" Margin="0,16,0,4" />
                                <TextBlock x:Name="BookProgressText" Text="—" HorizontalAlignment="Right"
                                           FontSize="9" Foreground="{DynamicResource TextSecondary}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <Grid x:Name="ResultsView" Grid.Row="1" Margin="14,12,14,25" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Button Content="←" Width="38" Height="32" HorizontalAlignment="Left"
                                Background="Transparent" BorderThickness="0" Click="BackToHome_Click" />
                        <TextBlock Text="学习成果" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                    </Grid>

                    <StackPanel Grid.Row="1">
                        <Border CornerRadius="18" Background="{DynamicResource PanelFill}"
                                BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1" Padding="16,14">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="1" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock x:Name="ResultTotalText" Text="—" FontFamily="Baskerville, Georgia"
                                                   FontSize="26" Foreground="{DynamicResource TextPrimary}" />
                                        <TextBlock Text="累计学习" Margin="0,5,0,0" FontSize="10"
                                                   Foreground="{DynamicResource TextSecondary}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock x:Name="ResultTodayText" Text="—" FontFamily="Baskerville, Georgia"
                                                   FontSize="26" Foreground="{DynamicResource TextPrimary}" />
                                        <TextBlock Text="今日完成" Margin="0,5,0,0" FontSize="10"
                                                   Foreground="{DynamicResource TextSecondary}" />
                                    </StackPanel>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource Divider}" Margin="0,14,0,12" />

                                <TextBlock Text="近 7 天" FontSize="10" Foreground="{DynamicResource TextSecondary}" />

                                <Grid Height="76" Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0"><Border x:Name="Bar0" Height="2" VerticalAlignment="Bottom" Margin="4,0" CornerRadius="3" Background="{DynamicResource Accent}" /></Grid>
                                    <Grid Grid.Column="1"><Border x:Name="Bar1" Height="2" VerticalAlignment="Bottom" Margin="4,0" CornerRadius="3" Background="{DynamicResource Accent}" /></Grid>
                                    <Grid Grid.Column="2"><Border x:Name="Bar2" Height="2" VerticalAlignment="Bottom" Margin="4,0" CornerRadius="3" Background="{DynamicResource Accent}" /></Grid>
                                    <Grid Grid.Column="3"><Border x:Name="Bar3" Height="2" VerticalAlignment="Bottom" Margin="4,0" CornerRadius="3" Background="{DynamicResource Accent}" /></Grid>
                                    <Grid Grid.Column="4"><Border x:Name="Bar4" Height="2" VerticalAlignment="Bottom" Margin="4,0" CornerRadius="3" Background="{DynamicResource Accent}" /></Grid>
                                    <Grid Grid.Column="5"><Border x:Name="Bar5" Height="2" VerticalAlignment="Bottom" Margin="4,0" CornerRadius="3" Background="{DynamicResource Accent}" /></Grid>
                                    <Grid Grid.Column="6"><Border x:Name="Bar6" Height="2" VerticalAlignment="Bottom" Margin="4,0" CornerRadius="3" Background="{DynamicResource Accent}" /></Grid>
                                </Grid>

                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="BarDay0" Grid.Column="0" Text="—" HorizontalAlignment="Center" FontSize="8" Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock x:Name="BarDay1" Grid.Column="1" Text="—" HorizontalAlignment="Center" FontSize="8" Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock x:Name="BarDay2" Grid.Column="2" Text="—" HorizontalAlignment="Center" FontSize="8" Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock x:Name="BarDay3" Grid.Column="3" Text="—" HorizontalAlignment="Center" FontSize="8" Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock x:Name="BarDay4" Grid.Column="4" Text="—" HorizontalAlignment="Center" FontSize="8" Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock x:Name="BarDay5" Grid.Column="5" Text="—" HorizontalAlignment="Center" FontSize="8" Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock x:Name="BarDay6" Grid.Column="6" Text="—" HorizontalAlignment="Center" FontSize="8" Foreground="{DynamicResource TextSecondary}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

